<?xml version="1.0"?>
<package format="3">
  <name>navila_adapter</name>
  <version>0.1.0</version>
  <description>RGB-only NaVILA text-action adapter for NavigationCommand.</description>
  <maintainer email="mifcom2@example.com">mifcom2</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>vln_interfaces</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-pil</exec_depend>
  <exec_depend>python3-requests</exec_depend>
  <export><build_type>ament_python</build_type></export>
</package>
